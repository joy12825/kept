{
  "name": "kept-prototype",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:oss": "tsc --noEmit -p tsconfig.oss.json",
    "test:oss": "KEPT_OSS=1 vitest run",
    "build:oss": "tsc --noEmit -p tsconfig.oss.json && KEPT_OSS=1 vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^9.4.0",
    "@mui/x-charts": "^9.15.0",
    "@tanstack/react-query": "^5.104.0",
    "epubjs": "^0.3.93",
    "lucide-react": "^0.460.0",
    "openapi-fetch": "^0.13.8",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
