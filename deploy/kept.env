# 收好（kept）的配置（二进制部署）。改完后：sudo systemctl restart kept
# 全部配置项见 docs/部署.md“三、配置”。

KEPT_DATA_DIR=/var/lib/kept
KEPT_HTTP_ADDR=:8000
TZ=Asia/Shanghai

# 手机连接与邮件里的链接用的地址（逗号分隔，按顺序尝试）
# KEPT_PUBLIC_URLS=http://192.168.1.10:8000

# KEPT_WORKERS=2
# KEPT_OCR_LANGUAGES=chi_sim+eng
# 扫描页自动转正、纠偏（默认开；转正要用 tesseract 的 osd 数据）
# KEPT_OCR_ROTATE=true
# KEPT_OCR_DESKEW=true
# KEPT_OCR_ROTATE_THRESHOLD=5
# KEPT_MAX_UPLOAD_SIZE=200MB
# KEPT_CONSUME_DIR=/mnt/nas/scans
# KEPT_BACKUP_DIR=/mnt/nas/kept-backups
# KEPT_GOTENBERG_URL=http://127.0.0.1:3000
# KEPT_TRUSTED_PROXIES=127.0.0.1
# KEPT_SMTP_HOST=smtp.example.com
